{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quaicu-website",
  "compatibility_date": "2026-05-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "_site",
    // Pages are served without ".html": /how-it-works serves how-it-works.html,
    // and /how-it-works.html redirects there. Canonical URLs match this.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get 404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
