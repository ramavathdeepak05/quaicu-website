<!doctype html>
<html lang="en" data-mode="light">
<head>
  <!-- Consent Mode: analytics stays off until the visitor accepts (banner in assets/site.js) -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });
    try { if (localStorage.getItem('qConsent') === 'granted') gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
  </script>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-NDQ7KG3W');</script>
  <!-- End Google Tag Manager -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% if seoTitle %}{{ seoTitle }}{% else %}{{ title }}{% if title %} · {% endif %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ seoDescription or description or site.description }}" />
  {% if noindex %}<meta name="robots" content="noindex, follow" />{% endif %}
  <link rel="canonical" href="{{ (page.url | absoluteUrl(site.url)) }}" />
  {% if preloadImage %}<link rel="preload" as="image" href="{{ preloadImage }}" />{% endif %}

  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:site_name" content="{{ site.title }}" />
  <meta property="og:url" content="{{ (page.url | absoluteUrl(site.url)) }}" />
  <meta property="og:title" content="{{ ogTitle or title or site.title }}" />
  <meta property="og:description" content="{{ ogDescription or seoDescription or description or site.description }}" />
  {% set shareImage = ogImage or hero or '/og-card.png' %}
  <meta property="og:image" content="{{ shareImage | absoluteUrl(site.url) }}" />
  {% if shareImage == '/og-card.png' %}<meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="QUAICU: Governed software for accountable business." />{% endif %}
  <meta property="og:locale" content="en_US" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ ogTitle or title or site.title }}" />
  <meta name="twitter:description" content="{{ ogDescription or seoDescription or description or site.description }}" />
  <meta name="twitter:image" content="{{ shareImage | absoluteUrl(site.url) }}" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/assets/brand/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#fafaf7" />
  <link rel="alternate" type="application/rss+xml" title="{{ site.blog.name }}" href="/blog/feed.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/site.css" />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NDQ7KG3W"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <div data-nav-slot></div>

  {{ content | safe }}

  <div data-foot-slot></div>
  <script src="/assets/nav.js"></script>
  <script src="/assets/site.js"></script>
</body>
</html>
