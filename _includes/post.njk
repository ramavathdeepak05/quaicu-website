---
layout: base.njk
ogType: article
---
{% set absoluteHero = (hero or "/og-card.png") | absoluteUrl(site.url) %}
{% set readMinutes = (content | readingTime) %}

<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ (description or "") | dump | safe }},
  "image": "{{ absoluteHero }}",
  "datePublished": "{{ page.date | isoDate }}",
  "dateModified": "{{ (updated or page.date) | isoDate }}",
  "author": {
    "@type": "{% if author and author != 'QUAICU' and author != site.author.name %}Person{% else %}Organization{% endif %}",
    "name": {{ (author or site.author.name) | dump | safe }},
    "url": "{{ site.url }}{% if author and author != 'QUAICU' and author != site.author.name %}/company{% endif %}"
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{ site.title }}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{ site.url }}/assets/brand/logo-512.png",
      "width": 512,
      "height": 512
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ page.url | absoluteUrl(site.url) }}"
  }
}</script>
<script type="application/ld+json">{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "QUAICU", "item": "{{ site.url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Notes", "item": "{{ site.url }}/blog/" },
    { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ page.url | absoluteUrl(site.url) }}" }
  ]
}</script>

<section class="page-hero post-hero" data-screen-label="01 Post Hero">
  <div class="shell">
    <div class="breadcrumb">
      <a href="/">QUAICU</a><span class="sep">/</span>
      <a href="/blog/">Notes</a><span class="sep">/</span>
      <span>{{ title }}</span>
    </div>
    <div class="grid-12">
      <div class="col-9">
        <div class="eyebrow"><span class="dot"></span>{{ (tags | first or "NOTE") | upper }} · {{ page.date | readableDate | upper }}</div>
        <h1 class="h1" style="margin-top: 24px;">{{ title }}</h1>
        {% if description %}
        <p class="lead" style="margin-top: 24px; max-width: 56ch;">{{ description }}</p>
        {% endif %}
        <div class="post-meta">
          <span>{{ readMinutes }} min read</span>
          <span class="sep">·</span>
          <span>{{ author or site.author.name }}</span>
          {% if tags and tags.length %}
          <span class="sep">·</span>
          <span>
            {% for tag in tags %}<a class="post-tag" href="/blog/tags/{{ tag | slugify }}/">#{{ tag }}</a>{% if not loop.last %} {% endif %}{% endfor %}
          </span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% if hero %}
  <div class="atmos atmos--hero" style="background-image: url('{{ hero }}');">
    <div class="atmos-caption"><span class="dot"></span>{{ (tags | first or "NOTE") | upper }}</div>
  </div>
  {% endif %}
</section>

<section data-screen-label="02 Post Body">
  <div class="shell">
    <article class="prose">
      {{ content | safe }}
    </article>
  </div>
</section>

{% set prev = collections.posts | getPreviousCollectionItem(page) %}
{% set next = collections.posts | getNextCollectionItem(page) %}
{% if prev or next %}
<section data-screen-label="03 Post Footer" class="section--bg" style="background-image: url('/uploads/stock-images/pexels-jakobjin-14452236.webp');">
  <div class="shell">
    <div class="section-head">
      <div class="kicker">CONTINUE READING</div>
      <div><h2 class="h2">More from <span class="muted">QUAICU Notes</span>.</h2></div>
    </div>
    <div class="grid-12" style="row-gap: 24px;">
      {% if prev %}
      <div class="col-6">
        <a class="post-nav-card" href="{{ prev.url }}">
          <div class="kicker">← PREVIOUS</div>
          <h3 class="h3" style="margin-top: 12px;">{{ prev.data.title }}</h3>
          {% if prev.data.description %}<p class="muted" style="font-size: 14px; margin-top: 12px;">{{ prev.data.description }}</p>{% endif %}
        </a>
      </div>
      {% endif %}
      {% if next %}
      <div class="col-6">
        <a class="post-nav-card" href="{{ next.url }}">
          <div class="kicker">NEXT →</div>
          <h3 class="h3" style="margin-top: 12px;">{{ next.data.title }}</h3>
          {% if next.data.description %}<p class="muted" style="font-size: 14px; margin-top: 12px;">{{ next.data.description }}</p>{% endif %}
        </a>
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<section data-screen-label="03b Related Services">
  <div class="shell">
    <div class="section-head">
      <div class="kicker">HOW QUAICU WORKS</div>
      <div><h2 class="h2">Governed delivery, <span class="muted">in practice</span>.</h2></div>
    </div>
    <div class="grid-12" style="row-gap: 24px;">
      <div class="col-4">
        <a class="post-nav-card" href="/trust">
          <div class="kicker">TRUST</div>
          <h3 class="h3" style="margin-top: 12px;">How every delivery stays checked</h3>
          <p class="muted" style="font-size: 14px; margin-top: 12px;">Rules that must not vary, a person who signs off, and a record of every action.</p>
        </a>
      </div>
      <div class="col-4">
        <a class="post-nav-card" href="/support">
          <div class="kicker">SUPPORT</div>
          <h3 class="h3" style="margin-top: 12px;">Managed software support</h3>
          <p class="muted" style="font-size: 14px; margin-top: 12px;">A fixed price per ticket, with a person reviewing every change.</p>
        </a>
      </div>
      <div class="col-4">
        <a class="post-nav-card" href="/for/regulated-teams">
          <div class="kicker">REGULATED TEAMS</div>
          <h3 class="h3" style="margin-top: 12px;">Support for regulated teams</h3>
          <p class="muted" style="font-size: 14px; margin-top: 12px;">Every change reviewed, every action recorded, for fintech, healthtech and edtech.</p>
        </a>
      </div>
    </div>
    <p class="muted" style="margin-top: 24px; font-size: 14px;">
      See <a href="/how-it-works">how it works</a> or <a href="/for/growing-businesses">support for growing businesses</a>.
    </p>
  </div>
</section>

<section data-screen-label="04 Post CTA">
  <div class="shell">
    <div style="border-top: 2px solid var(--fg); padding-top: 48px; display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end;">
      <h2 class="h2" style="max-width: 28ch;">Want software that stays accountable? Let's talk.</h2>
      <div class="row" style="gap: 12px;">
        <a class="btn btn--ghost btn--lg" href="/blog/">All notes<span class="arrow"></span></a>
        <a class="btn btn--primary btn--lg" href="/contact">Talk to us<span class="arrow"></span></a>
      </div>
    </div>
  </div>
</section>
