# Cloudflare Pages reads this file at the root of the build output (_site/).
# Format docs: https://developers.cloudflare.com/pages/configuration/headers/

# Asset filenames are not hashed, so a changed site.css must reach visitors
# soon: cache for an hour and revalidate.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate

# Uploaded images rarely change under the same name: cache for 30 days.
/uploads/*
  Cache-Control: public, max-age=2592000

# HTML must revalidate so new content shows up immediately after deploy.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Pretty URLs (blog posts, tag pages, blog index).
/blog/*
  Cache-Control: public, max-age=0, must-revalidate

# Admin should never be cached so CMS updates ship instantly.
/admin/*
  Cache-Control: no-store

# Sitemap + RSS get short caches so they refresh fast.
/sitemap.xml
  Cache-Control: public, max-age=300

/blog/feed.xml
  Cache-Control: public, max-age=300

# Security defaults — light touch so we don't break the brutalist site.
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=15552000
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
