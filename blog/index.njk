---
layout: base.njk
title: Notes
description: Field notes, product updates, and research from QUAICU. AI for regulated institutions.
pagination:
  data: collections.posts
  size: 10
  alias: pagePosts
  reverse: false
permalink: "{% if pagination.pageNumber == 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---

<section class="page-hero" data-screen-label="01 Notes Hero">
  <div class="shell">
    <div class="breadcrumb"><a href="/">QUAICU</a><span class="sep">/</span><span>Notes</span></div>
    <div class="grid-12">
      <div class="col-9">
        <div class="eyebrow"><span class="dot"></span>QUAICU NOTES</div>
        <h1 class="h1" style="margin-top: 24px;">Field notes from<br/>governed AI<br/><span class="muted">in regulated institutions.</span></h1>
        <p class="lead" style="margin-top: 32px; max-width: 56ch;">{{ site.blog.description }}</p>
      </div>
    </div>
  </div>
</section>

<section data-screen-label="02 Notes List">
  <div class="shell">
    {% if collections.tagList and collections.tagList.length %}
    <div class="post-meta" style="margin-bottom: 24px; margin-top: 0;">
      <span>FILTER ·</span>
      {% for tag in collections.tagList %}
        <a class="post-tag" href="/blog/tags/{{ tag | slugify }}/">#{{ tag }}</a>
      {% endfor %}
    </div>
    {% endif %}

    <div class="notes-list">
      {% for post in pagePosts %}
        <a class="notes-row" href="{{ post.url }}">
          <div class="notes-date">{{ post.date | ymdDate }}</div>
          <div class="notes-title">
            <h3>{{ post.data.title }}</h3>
            {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
          </div>
          <div class="notes-tags">
            {% for tag in (post.data.tags or []) %}#{{ tag }}{% if not loop.last %} {% endif %}{% endfor %}
          </div>
        </a>
      {% endfor %}
    </div>

    {% if pagination.pages.length > 1 %}
    <div class="notes-pager">
      <div>
        {% if pagination.href.previous %}
          <a href="{{ pagination.href.previous }}">← Newer</a>
        {% else %}
          <span class="disabled">← Newer</span>
        {% endif %}
      </div>
      <div>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</div>
      <div>
        {% if pagination.href.next %}
          <a href="{{ pagination.href.next }}">Older →</a>
        {% else %}
          <span class="disabled">Older →</span>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</section>

<section data-screen-label="03 CTA" class="section--bg" style="background-image: url('/uploads/stock-images/pexels-natasha-zoellner-328307832-32892986.jpg');">
  <div class="shell">
    <div style="border-top: 2px solid var(--fg); padding-top: 48px; display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end;">
      <h2 class="h2" style="max-width: 28ch;">Want governed AI in your institution? Start with the diagnostic.</h2>
      <div class="row" style="gap: 12px;">
        <a class="btn btn--ghost btn--lg" href="/blog/feed.xml">RSS<span class="arrow"></span></a>
        <a class="btn btn--primary btn--lg" href="/diagnostic.html">Book the Diagnostic<span class="arrow"></span></a>
      </div>
    </div>
  </div>
</section>
